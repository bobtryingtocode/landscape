{
  "name": "landscape-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Landscape iPhone app — the web app in a native shell (Capacitor).",
  "scripts": {
    "sync": "node scripts/sync-www.mjs && npx cap sync ios",
    "ios": "npm run sync && npx cap open ios",
    "assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#1f3d2b' --splashBackgroundColor '#f4f1ea'"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
